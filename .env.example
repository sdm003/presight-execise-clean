DATABASE_URL=******localhost:5432/directory
NODE_ENV=development
PORT=3001
SHUTDOWN_TIMEOUT_MS=10000
HTTP_MAX_IN_FLIGHT=64
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=10000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
PG_POOL_MAX=5
PG_MAX_QUEUE=20
PG_CONNECT_TIMEOUT_MS=10000
PG_STATEMENT_TIMEOUT_MS=15000
PG_LOCK_TIMEOUT_MS=3000
PG_IDLE_TRANSACTION_TIMEOUT_MS=10000
# Use true when the PostgreSQL server requires TLS with a trusted certificate.
PG_SSL=false
OTEL_ENABLED=false
OTEL_SAMPLE_RATIO=0.1
# Optional OTLP HTTP(S) collector endpoint. No credentials are allowed in the URL.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://otel-collector.example/v1/traces
# Docker Compose password: URL-encode reserved characters for DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-local-password
# Optional separate database for isolated integration tests.
# TEST_DATABASE_URL=******localhost:5432/directory_test
# Optional exact browser origin for a separately deployed frontend.
# CLIENT_ORIGIN=http://localhost:5173
